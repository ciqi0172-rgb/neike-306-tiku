{"meta":{},"topics":["全部","肠易激综合征"],"pages":[],"groups":[{"id":"med-new-ibs-manifest-001","title":"IBS表现","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"粪便可有黏液但绝无脓血；焦虑等使症状加重；体重无明显变化"},{"key":"B","label":"多为下腹和左下腹痛，极少在睡眠中痛醒，排便不净感"}],"stems":[{"number":1,"text":"IBS的粪便特点是","answer":["A"],"answerMode":"单选"},{"number":2,"text":"IBS腹痛的特点是","answer":["B"],"answerMode":"单选"},{"number":3,"text":"可加重IBS症状的因素是","answer":["A"],"answerMode":"单选"}],"topic":"肠易激综合征","lecture":"鉴别"},{"id":"med-new-ibs-treat-001","title":"IBS治疗药物归属组","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"解痉止痛：匹维溴铵、曲美布汀"},{"key":"B","label":"止泻：洛哌丁胺、地芬诺酯、蒙脱石散、药用炭"},{"key":"C","label":"缓解便秘：聚乙二醇"},{"key":"D","label":"调节内脏感觉（核心机制）：5-HT再摄取抑制剂、三环类抗抑郁药"},{"key":"E","label":"调节肠道炎症和菌群失调：利福昔明、益生菌"}],"stems":[{"number":1,"text":"IBS解痉止痛可选用","answer":["A"],"answerMode":"单选"},{"number":2,"text":"IBS止泻可选用","answer":["B"],"answerMode":"单选","mnemonic":"luo nuo tuo tan"},{"number":3,"text":"IBS缓解便秘可选用","answer":["C"],"answerMode":"单选"},{"number":4,"text":"针对IBS核心机制（调节内脏感觉）的药物是","answer":["D"],"answerMode":"单选"},{"number":5,"text":"IBS可选用的肠道抗生素是","answer":["E"],"answerMode":"单选"}],"topic":"肠易激综合征","lecture":"治疗"},{"id":"med-new-endo-summary-001","title":"消化系统内镜小结","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"IBS：结肠镜排除器质性病变"},{"key":"B","label":"需内镜确诊（并可活检）：食管癌；食管胃底静脉曲张（红色征可考虑预防性断流术）；反流性食管炎；急性胃炎；慢性胃炎；消化性溃疡及并发出血/幽门梗阻/癌变；胃癌；肠结核；克罗恩病；溃疡性结肠炎；大肠癌；判断消化道出血病因和止血等"},{"key":"C","label":"例外：胃食管反流病的金标准是食管反流监测（如电阻抗-pH监测），不是胃镜"}],"stems":[{"number":1,"text":"IBS结肠镜检查的目的是","answer":["A"],"answerMode":"单选"},{"number":2,"text":"食管胃底静脉曲张出现红色征可考虑","answer":["B"],"answerMode":"单选"},{"number":3,"text":"需要内镜确诊并可活检的消化系统疾病有（哪一组）","answer":["B"],"answerMode":"单选"},{"number":4,"text":"GERD诊断的例外之处是","answer":["C"],"answerMode":"单选"}],"topic":"肠易激综合征","lecture":"检查"}],"lectures":[]}