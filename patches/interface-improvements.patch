+const CATEGORY_ORDER = ['clinical', 'examination', 'diagnosis', 'mechanism', 'treatment', 'other']
+
+export const OPTION_CATEGORY_LABELS = {
+  clinical: '症状／体征',
+  examination: '检查／检验',
+  diagnosis: '诊断／分型',
+  mechanism: '病因／病理',
+  treatment: '治疗／用药',
+  other: '其他选项',
+}
+
+const CATEGORY_PATTERNS = {
+  treatment: /治疗|用药|药物|手术|切除|移植|放疗|化疗|溶栓|抗凝|抗血小板|抗生素|抗菌|吸入型|口服|静注|静脉注射|皮下注射|糖皮质激素|胰岛素|透析|输血|氧疗|吸氧|机械通气|支气管扩张剂|单抗|抑制剂|拮抗剂|激动剂|青霉素|头孢|喹诺酮|大环内酯|四环素|氨基糖苷|利福平|异烟肼|吡嗪酰胺|乙胺丁醇|链霉素|万古霉素|替考拉宁|利奈唑胺|奥司他韦|利巴韦林|阿昔洛韦|华法林|肝素|阿司匹林|氯吡格雷|替格瑞洛|尿激酶|茶碱|洋地黄|地高辛|利尿剂|强心|扩血管|营养支持|康复治疗|对症治疗/i,
+  examination: /检查|检验|培养|涂片|造影|超声|CT|MRI|MRPA|X线|心电图|脑电图|内镜|镜检|活检|穿刺|血气|血清|血浆|血常规|尿常规|粪常规|抗体|抗原|阳性|阴性|浓度|测定|试验|评分|量表|mMRC|FEV|FVC|PaO|PaCO|白细胞|红细胞|血小板|血沉|肌酐|转氨酶|胆红素|血糖|糖化|血脂|CTPA|DSA|HRCT|PAS|PPD|BALF|WBC|Hb|PLT|嗜酸性粒细胞|嗜酸性|嗜碱性|淋巴细胞|中性粒|粒细胞|血细胞|尿蛋白|蛋白尿|血尿|血氧|氧分压|二氧化碳分压|影像|磨玻璃|实变|充盈缺损|轨道征|地图样|铺路石样/i,
+  clinical: /症状|体征|发热|咳嗽|咳痰|咯血|胸痛|胸闷|呼吸困难|气短|喘息|哮鸣音|杂音|啰音|水肿|腹水|肝大|脾大|颈静脉|压痛|疼痛|腹痛|腹泻|恶心|呕吐|呕血|便血|黄疸|贫血|出血|瘀斑|皮疹|结节性红斑|溃疡|意识|昏迷|休克|抽搐|瘫痪|无力|麻木|心悸|晕厥|发绀|杵状指|叩诊|触诊|听诊|搏动|脉率|心率|血压|呼吸音|体温|体重|消瘦|盗汗|低热|高热|寒战|脓痰|铁锈色痰|吞咽困难|声音嘶哑|乳腺发育|高血钙|低血钠|三凹征|奇脉|沉默肺|坐位|端坐呼吸|喘气|乏力|疲劳|食欲|失眠|头痛|头晕/i,
+  diagnosis: /诊断|分型|分期|分级|危险分层|低危|中危|高危|轻型|重型|代偿期|失代偿期|急性期|慢性期|早期|晚期|缓解期|急性加重|A组|B组|E组|哮喘史|高风险|低风险|症状少|症状多|[ⅠⅡⅢⅣⅤ]级|I{1,3}级|IV级/i,
+  mechanism: /病因|发病机制|机制|导致|引起|所致|相关|遗传|自身免疫|感染|炎症|免疫|抵抗力|杆菌|病毒|细菌|真菌|支原体|衣原体|寄生虫|肉芽肿|纤维化|增生|萎缩|坏死|变性|栓塞|梗阻|狭窄|关闭不全|反流|功能障碍|缺乏|抵抗|突变|基因|气流受限|通气障碍|换气障碍|分流|阻塞|压迫|转移/i,
+}
+
+const TREATMENT_ACRONYM = /(?<![A-Za-z])(?:SABA|LABA|LAMA|SAMA|ICS|rt-PA|t-PA|ACEI|ARB|ARNI|NSAIDs?)(?![A-Za-z])/i
+
+export function inferOptionCategory(option) {
+  const label = String(option?.label || '')
+  if (!label) return 'other'
+  for (const category of ['treatment', 'examination', 'clinical', 'diagnosis', 'mechanism']) {
+    if (CATEGORY_PATTERNS[category].test(label) || (category === 'treatment' && TREATMENT_ACRONYM.test(label))) return category
+  }
+  return 'other'
+}
+
+function existingSections(group) {
+  if (group.optionBankSections?.length) {
+    return group.optionBankSections.map((section) => ({
+      title: section.title,
+      options: section.keys.map((key) => group.options.find((option) => option.key === key)).filter(Boolean),
+    })).filter((section) => section.options.length)
+  }
+  const categories = [...new Set(group.options.map((option) => option.category).filter(Boolean))]
+  return categories.map((category) => ({
+    title: category,
+    options: group.options.filter((option) => option.category === category),
+  }))
+}
+
+export function getOptionSections(group, displayMode = 'grouped') {
+  if (displayMode === 'original') return []
+  const curated = existingSections(group)
+  if (curated.length) return curated
+
+  const buckets = new Map(CATEGORY_ORDER.map((category) => [category, []]))
+  for (const option of group.options) buckets.get(inferOptionCategory(option)).push(option)
+  const meaningfulCategories = CATEGORY_ORDER.filter((category) => category !== 'other' && buckets.get(category).length)
+  if (meaningfulCategories.length < 2) return []
+
+  return CATEGORY_ORDER
+    .filter((category) => buckets.get(category).length)
+    .map((category) => ({ title: OPTION_CATEGORY_LABELS[category], options: buckets.get(category) }))
+}
