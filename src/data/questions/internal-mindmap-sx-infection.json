{"meta":{},"topics":["全部","外科感染"],"pages":[],"groups":[{"id":"sx-inf-overview-001","title":"感染概述与抗生素原则","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"破伤风、结核、真菌、气性坏疽"},{"key":"B","label":"去除感染灶+通畅引流"},{"key":"C","label":"有明确指征时"},{"key":"D","label":"严重、混合感染、需长程用药易耐药或减毒"}],"stems":[{"number":1,"text":"属于特异性感染的有（\"凤姐真坏\"）","answer":["A"],"answerMode":"单选"},{"number":2,"text":"外科治疗感染的基本原则（抗生素不能减免）是","answer":["B"],"answerMode":"单选"},{"number":3,"text":"预防性使用抗生素的前提是","answer":["C"],"answerMode":"单选"},{"number":4,"text":"联合使用抗生素的指征是","answer":["D"],"answerMode":"单选"}],"topic":"外科感染","lecture":"概述"},{"id":"sx-inf-soft-002","title":"软组织感染归属","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"蜂窝组织炎"},{"key":"B","label":"丹毒"},{"key":"C","label":"疖"},{"key":"D","label":"痈"},{"key":"E","label":"甲沟炎"},{"key":"F","label":"脓性指头炎"},{"key":"G","label":"掌深间隙感染"},{"key":"H","label":"脓毒症"}],"stems":[{"number":1,"text":"乙型溶血性链球菌所致，脓液稀薄、边界不清","answer":["A"],"answerMode":"单选"},{"number":2,"text":"皮肤淋巴管网感染，边界清楚的片状红疹（周围鲜红+中间淡红），反复发作可致象皮肿","answer":["B"],"answerMode":"单选","mnemonic":"一片丹清红淡红"},{"number":3,"text":"金葡菌所致，1个脓点","answer":["C"],"answerMode":"单选"},{"number":4,"text":"金葡菌所致，糖尿病者项背部多个相邻脓点（\"搭背\"）","answer":["D"],"answerMode":"单选"},{"number":5,"text":"金葡菌所致，指甲两侧呈U状","answer":["E"],"answerMode":"单选"},{"number":6,"text":"鱼刺刺伤等致指头针刺样痛→剧烈跳痛、肿胀加重→疼痛减轻","answer":["F"],"answerMode":"单选"},{"number":7,"text":"掌心凹消失（掌心隆起）、3/4/5指活动受限","answer":["G"],"answerMode":"单选"},{"number":8,"text":"G-杆菌为主，局部感染灶+突发高热或低体温+WBC明显↑或↓","answer":["H"],"answerMode":"单选"},{"number":9,"text":"主要致病菌为乙型溶血性链球菌的有","answer":["A","B"],"answerMode":"多选"}],"topic":"外科感染","lecture":"鉴别"},{"id":"sx-inf-surgery-003","title":"软组织感染外科处理","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"不切开引流、症状消失后继续用药"},{"key":"B","label":"十字切口、超过边缘、深达筋膜"},{"key":"C","label":"严禁挤压和切开"},{"key":"D","label":"甲沟旁纵向切口"},{"key":"E","label":"末节指侧面纵向切口"},{"key":"F","label":"切口近端不及掌横纹"},{"key":"G","label":"切口距腕横纹至少1.5cm