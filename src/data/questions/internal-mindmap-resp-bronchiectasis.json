{"meta":{},"topics":["全部","支气管扩张"],"pages":[],"groups":[{"id":"med-new-be-diagnosis-001","title":"病因、好发部位与表现","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"病因：多继发于支气管肺炎（麻疹/百日咳等）、慢支、肺结核"},{"key":"B","label":"好发于左肺下叶"},{"key":"C","label":"干性支扩好发于上叶尖后段（与肺结核有关）"},{"key":"D","label":"长期咳大量脓痰（“痰盂”）、多有咯血和杵状指、固定持久的湿啰音（可能可能最可能）"}],"stems":[{"number":1,"text":"支气管扩张多继发于","answer":["A"],"answerMode":"单选"},{"number":2,"text":"支气管扩张好发部位是","answer":["B"],"answerMode":"单选"},{"number":3,"text":"干性支扩好发部位是","answer":["C"],"answerMode":"单选"},{"number":4,"text":"长期咳大量脓痰、咯血、杵状指、固定持久的湿啰音，最可能诊断是","answer":["D"],"answerMode":"单选"}],"topic":"支气管扩张","lecture":"表现"},{"id":"med-new-be-hrct-001","title":"HRCT金标准","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"金标准：HRCT"},{"key":"B","label":"多发薄壁囊腔、管壁增厚呈双轨征"},{"key":"C","label":"部分见液平、印戒征、卷发征"}],"stems":[{"number":1,"text":"诊断支气管扩张的金标准是","answer":["A"],"answerMode":"单选"},{"number":2,"text":"支扩HRCT的典型征象有（双轨征）","answer":["B"],"answerMode":"单选"},{"number":3,"text":"支扩HRCT的典型征象有（印戒征、卷发征）","answer":["C"],"answerMode":"单选"}],"topic":"支气管扩张","lecture":"检查"},{"id":"med-new-be-sputum-001","title":"脓痰处理（转折）","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"清除分泌物——雾化吸入高渗生理盐水或乙酰半胱氨酸"},{"key":"B","label":"体位引流：头低臀部抬高"},{"key":"C","label":"排痰不宜过快以防窒息"}],"stems":[{"number":1,"text":"支扩清除分泌物可用","answer":["A"],"answerMode":"单选"},{"number":2,"text":"支扩体位引流的体位是","answer":["B"],"answerMode":"单选"},{"number":3,"text":"男，40岁，支扩，大量脓痰，行体位引流。排痰时的注意事项是","answer":["C"],"answerMode":"单选"}],"topic":"支气管扩张","lecture":"治疗"},{"id":"med-new-be-hemoptysis-001","title":"咯血分度与治疗（转折）","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"咯血见于50%~70%；咯血量与疾病严重程度不完全相关"},{"key":"B","label":"干性支扩：以反复咯血为唯一症状"},{"key":"C","label":"咯血量中：垂体后叶素或酚妥拉明"},{"key":"D","label":"咯血量大（>500ml/d或>100ml/次“五一”）——病变弥漫：介入栓塞支气管动脉"},{"key":"E","label":"咯血量大——病变局限：手术切除"}],"stems":[{"number":1,"text":"支扩咯血的特点是","answer":["A"],"answerMode":"单选"},{"number":2,"text":"以反复咯血为唯一症状的是","answer":["B"],"answerMode":"单选"},{"number":3,"text":"女，35岁，支扩，咯血量中等。首选药物是","answer":["C"],"answerMode":"单选"},{"number":4,"text":"男，42岁，支扩，咯血600ml/d，病变弥漫。应采取","answer":["D"],"answerMode":"单选"},{"number":5,"text":"男，42岁，支扩，咯血600ml/d，病变局限。应采取","answer":["E"],"answerMode":"单选"}],"topic":"支气管扩张","lecture":"治疗"},{"id":"med-new-be-antibiotic-001","title":"铜绿假单胞菌高危用药（并列组）","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"无铜绿假单胞菌感染高危因素：针对流感嗜血杆菌"},{"key":"B","label":"高危因素：住院、FEV₁<30%预计值等"},{"key":"C","label":"头孢他啶/哌酮/吡肼等三四代头孢"},{"key":"D","label":"哌拉西林-他唑巴坦"},{"key":"E","label":"亚胺培南/美罗培南等碳青霉烯类（不选厄他培南“恶心”）"},{"key":"F","label":"环丙沙星/左氧氟沙星等呼吸喹诺酮（不选诺氟沙星“懦夫”）"},{"key":"G","label":"妥布霉素等氨基糖苷类"}],"stems":[{"number":1,"text":"支扩合并急性感染、无铜绿假单胞菌高危因素时，针对的病原体是","answer":["A"],"answerMode":"单选","mnemonic":"按头窥探：他坐着排稀"},{"number":2,"text":"铜绿假单胞菌感染的高危因素有","answer":["B"],"answerMode":"单选"},{"number":3,"text":"有铜绿高危因素时可选用三四代头孢","answer":["C"],"answerMode":"单选"},{"number":4,"text":"有铜绿高危因素时可选用哌拉西林-他唑巴坦","answer":["D"],"answerMode":"单选"},{"number":5,"text":"碳青霉烯类中不选用的是（厄他培南）","answer":["E"],"answerMode":"单选"},{"number":6,"text":"呼吸喹诺酮中不选用的是（诺氟沙星）","answer":["F"],"answerMode":"单选"},{"number":7,"text":"有铜绿高危因素时可选用氨基糖苷类","answer":["G"],"answerMode":"单选"}],"topic":"支气管扩张","lecture":"治疗"},{"id":"med-new-be-clubbing-001","title":"杵状指小结","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"支扩"},{"key":"B","label":"慢性肺脓肿"},{"key":"C","label":"慢性脓胸"},{"key":"D","label":"肺癌"},{"key":"E","label":"间质性肺病"},{"key":"F","label":"亚心炎"},{"key":"G","label":"法洛四联症"}],"stems":[{"number":1,"text":"可出现杵状指的疾病有","answer":["A","B","C","D","E","F","G"],"answerMode":"多选","mnemonic":"硬硬吱吱炎炎脓脓没事哎"}],"topic":"支气管扩张","lecture":"表现"}],"lectures":[]}