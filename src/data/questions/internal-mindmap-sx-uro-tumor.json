{"meta":{},"topics":["全部","泌尿系统感染与肿瘤"],"pages":[],"groups":[{"id":"sx-ut-tb-001","title":"肾结核","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"慢性膀胱刺激症、血尿在刺激症后出现"},{"key":"B","label":"抗结核"},{"key":"C","label":"抗结核+患肾切除"},{"key":"D","label":"尿结核杆菌培养"},{"key":"E","label":"静脉尿路造影（IVU/IVP）"}],"stems":[{"number":1,"text":"肾结核的典型表现是","answer":["A"],"answerMode":"单选"},{"number":2,"text":"肾盂无或很少破坏时的治疗是","answer":["B"],"answerMode":"单选"},{"number":3,"text":"6~9个月无效、肾盂破坏严重或肾无功能时的治疗是（术前抗结核>2周）","answer":["C"],"answerMode":"单选"},{"number":4,"text":"肾结核确诊的金标准是","answer":["D"],"answerMode":"单选"},{"number":5,"text":"决定肾结核治疗必不可少的检查是","answer":["E"],"answerMode":"单选"}],"topic":"泌尿系统感染与肿瘤","lecture":"诊疗"},{"id":"sx-ut-tumor-002","title":"泌尿系肿瘤归属","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"肾癌"},{"key":"B","label":"上尿路癌（肾盂癌/输尿管癌）"},{"key":"C","label":"膀胱癌"},{"key":"D","label":"前列腺癌"}],"stems":[{"number":1,"text":"透明细胞癌多见，可有腹部肿块、同侧精索静脉曲张平卧不消失（癌栓）的是","answer":["A"],"answerMode":"单选"},{"number":2,"text":"移行细胞癌多见，可有条状血块、膀胱镜下输尿管口喷血的是","answer":["B"],"answerMode":"单选"},{"number":3,"text":"移行细胞癌多见，可有凝血块、无膀胱刺激症或晚期出现的是","answer":["C"],"answerMode":"单选"},{"number":4,"text":"腺癌多见，好发于外周带、直肠指检触及硬结的是","answer":["D"],"answerMode":"单选"}],"topic":"泌尿系统感染与肿瘤","lecture":"鉴别"},{"id":"sx-ut-surg-003","title":"泌尿系肿瘤术式归属","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"经尿道膀胱肿瘤切除术（TURBT）"},{"key":"B","label":"根治性膀胱切除+尿流改道"},{"key":"C","label":"根治性肾切除+全长输尿管+开口部膀胱壁"},{"key":"D","label":"根治性前列腺切除术"},{"key":"E","label":"抗雄激素药+去势治疗"}],"stems":[{"number":1,"text":"非肌层浸润性膀胱癌选用","answer":["A"],"answerMode":"单选","mnemonic":"bladder"},{"number":2,"text":"肌层浸润性膀胱癌（T2~T4）、非移行细胞癌选用","answer":["B"],"answerMode":"单选"},{"number":3,"text":"上尿路癌选用","answer":["C"],"answerMode":"单选"},{"number":4,"text":"癌局限在前列腺内选用","answer":["D"],"answerMode":"单选"},{"number":5,"text":"癌突破前列腺选用","answer":["E"],"answerMode":"单选"}],"topic":"泌尿系统感染与肿瘤","lecture":"治疗"},{"id":"sx-ut-exam-004","title":"泌尿系肿瘤检查归属"