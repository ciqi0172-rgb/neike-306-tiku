{"meta":{},"topics":["全部","传染病"],"pages":[],"groups":[{"id":"path-new-inf-sch-001","title":"血吸虫病","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"虫卵引起的损害最主要最严重（肉芽肿）；虫卵主要沉着于直肠、乙状结肠、肝；属IV型变态反应"},{"key":"B","label":"急性虫卵结节：放射状火焰样嗜酸性棒状物（Hoeppli）；嗜酸性脓肿（大量嗜酸性粒细胞）；Charcot-Leyden结晶；虫卵周围肉芽组织含大量嗜酸性粒细胞；晚期出现类上皮细胞"},{"key":"C","label":"慢性虫卵结节／假结核结节：毛蚴已死亡；类上皮细胞为主；少量异物巨细胞、淋巴细胞、成纤维细胞"}],"stems":[{"number":1,"text":"血吸虫病最主要最严重的损害是","answer":["A"],"answerMode":"单选"},{"number":2,"text":"属IV型变态反应的是","answer":["A"],"answerMode":"单选"},{"number":3,"text":"Hoeppli棒状物、嗜酸性脓肿见于","answer":["B"],"answerMode":"单选"},{"number":4,"text":"Charcot-Leyden结晶见于","answer":["B"],"answerMode":"单选"},{"number":5,"text":"毛蚴已死亡、类上皮细胞为主（假结核结节）的是","answer":["C"],"answerMode":"单选","mnemonic":"凌晨累异"}],"topic":"传染病","lecture":"血吸虫病"},{"id":"path-new-inf-syph-001","title":"梅毒分期与病变","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"基本病变：闭塞性动脉内膜炎、小血管周围炎、肉芽肿（特征）"},{"key":"B","label":"一期：硬下疳"},{"key":"C","label":"二期（传染性最大）：梅毒疹"},{"key":"D","label":"三期（传染性最小）：树胶样肿／梅毒瘤（肉芽肿）；浆细胞和淋巴细胞多见（浆细胞恒定出现）；类上皮细胞和朗汉斯巨细胞少见；凝固性坏死（可见原有血管壁轮廓）；绝少钙化"},{"key":"E","label":"三期累及心血管和神经：主动脉炎、主动脉瓣关闭不全、主动脉瘤、麻痹性痴呆、脊髓痨、马鞍鼻"}],"stems":[{"number":1,"text":"梅毒的基本病变是","answer":["A"],"answerMode":"单选"},{"number":2,"text":"硬下疳见于","answer":["B"],"answerMode":"单选"},{"number":3,"text":"传染性最大的是","answer":["C"],"answerMode":"单选"},{"number":4,"text":"树胶样肿见于","answer":["D"],"answerMode":"单选"},{"number":5,"text":"浆细胞恒定出现（“乌梅子酱”）见于","answer":["D"],"answerMode":"单选","mnemonic":"乌梅子酱"},{"number":6,"text":"凝固性坏死、可见原有血管壁轮廓、绝少钙化的是","answer":["D"],"answerMode":"单选"},{"number":7,"text":"主动脉瘤、脊髓痨、马鞍鼻见于","answer":["E"],"answerMode":"单选","mnemonic":"主主主延毕咯"}],"topic":"传染病","lecture":"梅毒"},{"id":"path-new-inf-std-001","title":"尖锐湿疣与淋病","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"尖锐湿疣：HPV-6、11型等；挖空／凹空细胞"},{"key":"B","label":"淋病：急性化脓性炎"}],"stems":[{"number":1,"text":"挖空／凹空细胞见于","answer":["A"],"answerMode":"单选"},{"number":2,"text":"急性化脓性炎的性传