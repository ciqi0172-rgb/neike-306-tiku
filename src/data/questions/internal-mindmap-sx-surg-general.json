{"meta":{},"topics":["全部","其他外科总论"],"pages":[],"groups":[{"id":"sx-sg-sterile-001","title":"灭菌方法","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"高压蒸汽"},{"key":"B","label":"化学气体（环氧乙烷等）"},{"key":"C","label":"煮沸1小时"},{"key":"D","label":"戊二醛浸泡10小时"},{"key":"E","label":"干热/火烧"},{"key":"F","label":"电离辐射"}],"stems":[{"number":1,"text":"最常用的灭菌方法，有效期2周","answer":["A"],"answerMode":"单选"},{"number":2,"text":"不耐高温物品（仪器、导管、内镜，\"胰岛内分泌\"）","answer":["B"],"answerMode":"单选"},{"number":3,"text":"耐高温物品（金属器械、玻璃、橡胶）","answer":["C"],"answerMode":"单选"},{"number":4,"text":"锐利器械、内镜","answer":["D"],"answerMode":"单选"},{"number":5,"text":"玻璃、粉剂、油剂","answer":["E"],"answerMode":"单选"},{"number":6,"text":"γ射线灭菌属于","answer":["F"],"answerMode":"单选"}],"topic":"其他外科总论","lecture":"灭菌"},{"id":"sx-sg-trauma-002","title":"创伤处理与微创","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"四肢大出血加压包扎无法止血者"},{"key":"B","label":"细绳、电线"},{"key":"C","label":"每隔1小时"},{"key":"D","label":"不超过4小时"},{"key":"E","label":"伤后6~8小时内"},{"key":"F","label":"火器伤"},{"key":"G","label":"CO2气腹"}],"stems":[{"number":1,"text":"止血带的适应证是","answer":["A"],"answerMode":"单选"},{"number":2,"text":"止血带禁用的材料是","answer":["B"],"answerMode":"单选"},{"number":3,"text":"止血带放松1~2分钟的间隔是","answer":["C"],"answerMode":"单选"},{"number":4,"text":"止血带使用的时限是","answer":["D"],"answerMode":"单选"},{"number":5,"text":"开放伤清创后一期缝合的时限是","answer":["E"],"answerMode":"单选"},{"number":6,"text":"清创后不做一期缝合的伤类是","answer":["F"],"answerMode":"单选"},{"number":7,"text":"腹腔镜手术特殊并发症的相关因素是","answer":["G"],"answerMode":"单选"}],"topic":"其他外科总论","lecture":"创伤"},{"id":"sx-sg-tx-003","title":"移植","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"肾移植"},{"key":"B","label":"小肠移植"}],"stems":[{"number":1,"text":"疗效最显著的移植（慢性排斥反应是最大障碍）","answer":["A"],"answerMode":"单选"},{"number":2,"text":"排斥反应发生率最高、易并发严重感染和GVHD","answer":["B"],"answerMode":"单选"}],"topic":"其他外科总论","lecture":"移植"},{"id":"sx-sg-tumor-004","title":"肿瘤预防与皮肤病变","kind":"B","kindLabel":"B型题","options":[{"key":"