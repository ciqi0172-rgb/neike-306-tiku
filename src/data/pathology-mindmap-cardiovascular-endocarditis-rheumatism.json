{"meta":{},"topics":["全部","循环系统"],"pages":[],"groups":[{"id":"path-new-cardio-endo-001","title":"急性与亚急性感染性心内膜炎对比","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"金葡菌（最多见）、溶血性链球菌、肺炎链球菌等毒力较强的化脓菌"},{"key":"B","label":"草绿色链球菌等毒力较弱"},{"key":"C","label":"正常心瓣膜即可侵犯"},{"key":"D","label":"病变心瓣膜（如风湿病）"},{"key":"E","label":"赘生物易脱落形成栓子→败血性／感染性梗死"},{"key":"F","label":"赘生物易脱落形成栓子→无菌性梗死（栓塞最多见于脑）"},{"key":"G","label":"瓣膜穿孔"},{"key":"H","label":"瓣膜变形"},{"key":"I","label":"肾小球肾炎和Osler小结少见"},{"key":"J","label":"肾小球肾炎和Osler小结多见"}],"stems":[{"number":1,"text":"急性感染性心内膜炎的特点是","answer":["A","C","E","G","I"],"answerMode":"多选"},{"number":2,"text":"亚急性感染性心内膜炎的特点是","answer":["B","D","F","H","J"],"answerMode":"多选","mnemonic":"小草很弱"},{"number":3,"text":"亚急性感染性心内膜炎栓塞的特点是","answer":["F"],"answerMode":"单选"}],"topic":"循环系统","lecture":"感染性心内膜炎"},{"id":"path-new-cardio-endo-002","title":"心瓣膜受累连线","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"二尖瓣＋主动脉瓣"},{"key":"B","label":"二尖瓣（其次二尖瓣＋主动脉瓣）"},{"key":"C","label":"McCallum斑"},{"key":"D","label":"疣状赘生物：瓣膜闭锁缘的白色血栓（血小板为主）、不易脱落"},{"key":"E","label":"慢性心瓣膜病：瓣膜狭窄或关闭不全"}],"stems":[{"number":1,"text":"感染性心内膜炎主要累及的瓣膜是","answer":["A"],"answerMode":"单选"},{"number":2,"text":"风湿性心内膜炎（最严重）累及的瓣膜是","answer":["B"],"answerMode":"单选"},{"number":3,"text":"风湿性心内膜炎中受血流冲击引起心内膜灶状增厚形成","answer":["C"],"answerMode":"单选"},{"number":4,"text":"风湿性心内膜炎瓣膜闭锁缘疣状赘生物的特点是","answer":["D"],"answerMode":"单选"},{"number":5,"text":"风湿性心内膜炎反复发作导致的慢性病变是","answer":["E"],"answerMode":"单选"}],"topic":"循环系统","lecture":"感染性心内膜炎"},{"id":"path-new-cardio-rhe-001","title":"风湿病的病因与病理变化分期","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"变质渗出期"},{"key":"B","label":"增生期"},{"key":"C","label":"纤维化期"},{"key":"D","label":"风湿小体（Aschoff小体）"},{"key":"E","label":"风湿小体机化形成梭形小瘢痕"},{"key":"F","label":"风湿细胞核的切面呈枭眼状、毛虫状，可有多核"},{"key":"G","label":"A组β型溶血性链球菌"}],"stems":[{"number":1,"text":"风湿病的病因（变态反应）相关病原体是","answer":["G"],"answerMode":"单选"},{"number":2,"text":"风湿病病理变化的正确顺序是","answer":["A","B","C"],"answerMode":"多选"},{"number":3,"text":"增生期的特征是","answer":["D"],"answerMode":"单选"},{"number":4,"text":"纤维化期的变化是","answer":["E"],"answerMode":"单选"},{"number":5,"text":"风湿细胞的形态特点是","answer":["F"],"answerMode":"单选"}],"topic":"循环系统","lecture":"风湿病"},{"id":"path-new-cardio-rhe-002","title":"风湿病累及全身结缔组织的归属","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"心内膜炎（最严重）"},{"key":"B","label":"心肌炎（间质小血管旁见Aschoff小体）"},{"key":"C","label":"心外膜炎／心包炎（心包积液浆液为主；绒毛心纤维素为主→缩窄性心包炎）"},{"key":"D","label":"关节（浆液为主，无关节畸形）"},{"key":"E","label":"环形红斑（渗出，没有Aschoff小体）"},{"key":"F","label":"皮下结节（增生）"},{"key":"G","label":"血管（小动脉为主，血管壁纤维素样坏死）"},{"key":"H","label":"锥体外系（小舞蹈病）"}],"stems":[{"number":1,"text":"风湿病累及心脏的表现包括","answer":["A","B","C"],"answerMode":"多选"},{"number":2,"text":"风湿病累及关节的特点是","answer":["D"],"answerMode":"单选","mnemonic":"舔过关节咬住心脏"},{"number":3,"text":"风湿病皮肤表现包括","answer":["E","F"],"answerMode":"多选"},{"number":4,"text":"属于渗出性、没有Aschoff小体的皮肤表现是","answer":["E"],"answerMode":"单选"},{"number":5,"text":"小舞蹈病累及的部位是","answer":["H"],"answerMode":"单选"},{"number":6,"text":"以血管壁纤维素样坏死为主的风湿病累及部位是","answer":["G"],"answerMode":"单选"}],"topic":"循环系统","lecture":"风湿病"}],"lectures":[]}