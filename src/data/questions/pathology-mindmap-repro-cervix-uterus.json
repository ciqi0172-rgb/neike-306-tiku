swerMode":"单选"},{"number":3,"text":"发展为子宫内膜癌概率1／3、明显背靠背但无间质浸润的是","answer":["C"],"answerMode":"单选"},{"number":4,"text":"核分裂象增多的是","answer":["D"],"answerMode":"单选"}],"topic":"生殖系统疾病","lecture":"宫体疾病"}],"lectures":[]}