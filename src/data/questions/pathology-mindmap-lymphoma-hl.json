{"meta":{},"topics":["全部","淋巴造血系统"],"pages":[],"groups":[{"id":"path-new-lym-hl-001","title":"霍奇金淋巴瘤：RS细胞与CHL亚型","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"典型RS细胞：双核（镜影细胞）或多核瘤巨细胞、核大、核仁明显呈红色、无核分裂象"},{"key":"B","label":"霍奇金细胞（单核，不典型）"},{"key":"C","label":"变异RS细胞：陷窝、爆米花、木乃伊／干尸细胞"},{"key":"D","label":"结节性淋巴细胞为主型（NLPHL）：爆米花细胞，预后最好"},{"key":"E","label":"EBV感染、典型RS细胞、多种炎细胞混合浸润为背景"},{"key":"F","label":"结节硬化型：陷窝细胞；EBV感染率低；青年妇女、纵隔肿块多见；不转变为其他亚型"},{"key":"G","label":"混合细胞型：典型RS和单核RS"},{"key":"H","label":"富于淋巴细胞型：大量淋巴细胞"},{"key":"I","label":"淋巴细胞减少型：典型RS或多形性瘤细胞；EBV感染率接近100%；HIV者多见"}],"stems":[{"number":1,"text":"RS细胞的典型形态是","answer":["A"],"answerMode":"单选","mnemonic":"三大一红无分裂"},{"number":2,"text":"不典型的RS相关细胞包括","answer":["B","C"],"answerMode":"多选"},{"number":3,"text":"预后最好的HL类型是","answer":["D"],"answerMode":"单选"},{"number":4,"text":"CHL共同的背景特点是","answer":["E"],"answerMode":"单选"},{"number":5,"text":"结节硬化型的特点包括","answer":["F"],"answerMode":"单选","mnemonic":"姐姐"},{"number":6,"text":"混合细胞型的特征细胞是","answer":["G"],"answerMode":"单选"},{"number":7,"text":"富于淋巴细胞型的特点是","answer":["H"],"answerMode":"单选"},{"number":8,"text":"淋巴细胞减少型的特点是","answer":["I"],"answerMode":"单选"},{"number":9,"text":"CHL各亚型预后由好到差的排序是","answer":["H","F","G","I"],"answerMode":"多选","mnemonic":"结婚"},{"number":10,"text":"《病理》发病率最高的CHL亚型是","answer":["F"],"answerMode":"单选"}],"topic":"淋巴造血系统","lecture":"淋巴瘤"}],"lectures":[]}