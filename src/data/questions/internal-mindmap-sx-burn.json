{"meta":{},"topics":["全部","烧伤"],"pages":[],"groups":[{"id":"sx-bn-area-001","title":"烧伤面积（九分法）","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"3、3、3"},{"key":"B","label":"5、6、7"},{"key":"C","label":"13、13、1"},{"key":"D","label":"5、7、13、21"},{"key":"E","label":"6、6、13、21"}],"stems":[{"number":1,"text":"发、面、颈","answer":["A"],"answerMode":"单选"},{"number":2,"text":"双手、双前臂、双上臂","answer":["B"],"answerMode":"单选"},{"number":3,"text":"躯干前、躯干后、会阴","answer":["C"],"answerMode":"单选"},{"number":4,"text":"双臀、双足、双小腿、双大腿（成年男性）","answer":["D"],"answerMode":"单选"},{"number":5,"text":"成年女性的双臀、双足、双小腿、双大腿更改为","answer":["E"],"answerMode":"单选"}],"topic":"烧伤","lecture":"面积"},{"id":"sx-bn-depth-002","title":"烧伤深度","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"Ⅰ度"},{"key":"B","label":"浅Ⅱ度"},{"key":"C","label":"深Ⅱ度"},{"key":"D","label":"Ⅲ度"}],"stems":[{"number":1,"text":"损伤表皮浅层，红斑状干燥无水疱、烧灼感，<1周愈合","answer":["A"],"answerMode":"单选","mnemonic":"Ⅰ浅Ⅱ痂Ⅲ全层"},{"number":2,"text":"损伤部分表皮生发层或真皮乳头层（\"发如雪\"），湿润红润、大小不一水疱、疼痛显著，10天~2周愈合","answer":["B"],"answerMode":"单选"},{"number":3,"text":"损伤部分真皮网状层，湿润红白相间、可有小水疱、痛觉迟钝，3~4周愈合伴瘢痕增生","answer":["C"],"answerMode":"单选"},{"number":4,"text":"损伤皮肤全层甚至皮下脂肪肌肉，蜡白焦黄炭化、树枝状栓塞血管、痛觉消失，需植皮","answer":["D"],"answerMode":"单选"}],"topic":"烧伤","lecture":"深度"},{"id":"sx-bn-shock-003","title":"低血容量性休克补液","kind":"B","kindLabel":"B型题","options":[{"key":"A","label":"1.5ml"},{"key":"B","label":"2:1"},{"key":"C","label":"1:1"},{"key":"D","label":"2000ml"},{"key":"E","label":"前8小时"}],"stems":[{"number":1,"text":"每1%Ⅱ、Ⅲ度烧伤面积每kg体重的补液量","answer":["A"],"answerMode":"单选"},{"number":2,"text":"一般情况下晶体：胶体的比例","answer":["B"],"answerMode":"单选"},{"number":3,"text":"广泛深度烧伤时晶体：胶体的比例","answer":["C"],"answerMode":"单选"},{"number":4,"text":"每日基础水分（葡萄糖溶液）量","answer":["D"],"answerMode":"单选"},{"number":5,"text":"补液总量一半应在伤后多长时间内输入","answer":["E"],"answerMode":"单选"}],"topic":"烧伤","lecture":"补液"}],"lectures":[]}